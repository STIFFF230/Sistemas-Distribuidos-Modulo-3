# Copia este archivo a ".env" (en la raíz del proyecto) y ajusta la IP cada
# vez que cambie la de la VM Debian (por ejemplo, después de reiniciarla).
#
# Ambos clientes (Cliente2 en Swift y Clienter1 en Python) leen este archivo
# automáticamente al arrancar, buscándolo desde su propio directorio hacia
# arriba — no hace falta exportar variables de entorno a mano ni tocar
# código. Ver DESPLIEGUE.md.

CHAT_HOST=172.16.238.130
CHAT_PORT=5000
